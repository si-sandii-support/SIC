VITE_API_URL=https://sic-acq.pages.dev/api
NODE_ENV=development
PORT=4000
CORS_ORIGIN=https://sic-acq.pages.dev/
MAX_BODY_MB=50

# Optional SMTP provider. When configured, SIC sends the selected export as an attachment.
# Without SMTP configuration, SIC opens a prefilled mail draft and downloads the file.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@example.com
SMTP_PASS=your-app-password
SMTP_FROM=your-sender@example.com

# Optional Meta WhatsApp Cloud API. When configured, Send WhatsApp submits the message and
# selected export to each added recipient. Otherwise SIC opens individual prefilled chats;
# browser links cannot auto-attach a file or send to many numbers in a single WhatsApp chat.
# Use only for opted-in recipients and follow Meta message-template / customer-service-window rules.
# WHATSAPP_PHONE_NUMBER_ID is the default Meta Business phone-number ID, NOT a recipient number.
# Users may override the ID in SIC settings; the access token must stay on this API server.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0

VITE_API_URL=http://localhost:4000/api
VITE_DONATION_URL=https://example.com/support
