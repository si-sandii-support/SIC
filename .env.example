# LOCAL DEVELOPMENT ONLY. Do not use these URLs for the Cloudflare Pages production build.
NODE_ENV=production
PORT=4000
# Exact frontend origin; no trailing slash or /api path.
CORS_ORIGIN=https://sic-net.netlify.app/
TRUST_PROXY=true
GLOBAL_RATE_LIMIT=120
CONVERT_RATE_LIMIT=20
SHARE_RATE_LIMIT=10
VALIDATE_RATE_LIMIT=30
RENDER_RATE_LIMIT=5
MAX_BODY_MB=50

# Optional SMTP provider for server-side email delivery. Keep credentials on the API host only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Meta WhatsApp Cloud API. Keep access tokens on the API host only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0

# Local frontend uses the Vite /api proxy. Set this only if your local dev proxy should target another API host.
# SIC_DEV_API_PROXY_TARGET=http://localhost:4000
# For Cloudflare Pages production, set VITE_API_URL in Pages build settings to
# https://YOUR-REAL-API-HOST.onrender.com/api (replace with your actual API host).
VITE_API_URL=
VITE_DONATION_URL=
