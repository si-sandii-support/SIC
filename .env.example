# Local development settings. Do not use this file as the Cloudflare production config.
NODE_ENV=development
PORT=4000
CORS_ORIGIN=https://sic-acq.pages.dev/
TRUST_PROXY=false
GLOBAL_RATE_LIMIT=120
CONVERT_RATE_LIMIT=20
SHARE_RATE_LIMIT=10
VALIDATE_RATE_LIMIT=30
RENDER_RATE_LIMIT=5
MAX_BODY_MB=50

# Optional SMTP provider for server-side email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Meta WhatsApp Cloud API. Keep access tokens on the API server only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0

# Local frontend -> local Express API.
VITE_API_URL=https://sic-acq.pages.dev/api
VITE_DONATION_URL=
