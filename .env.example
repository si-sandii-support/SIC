# SIC Backend Configuration
NODE_ENV=development
PORT=4000
TRUST_PROXY=false

# CORS
CORS_ORIGIN=http://localhost:5173

# Request limits
MAX_BODY_MB=50
GLOBAL_RATE_LIMIT=120
CONVERT_RATE_LIMIT=20
SHARE_RATE_LIMIT=10
VALIDATE_RATE_LIMIT=30
RENDER_RATE_LIMIT=5

# SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp Cloud API Configuration
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0