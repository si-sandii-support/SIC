{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": "> 0.5%, not dead, not op_mini all",
        "modules": false
      }
    ],
    [
      "@babel/preset-react",
      {
        "runtime": "automatic"
      }
    ]
  ],
  "plugins": [
    [
      "@babel/plugin-transform-react-constant-elements"
    ]
  ]
}
