{
  "name": "si-document-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/backend\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/backend && npm run build -w apps/web",
    "start": "npm run start -w apps/backend",
    "build:webpack": "npm run build:webpack -w apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "displayName": "SIC",
  "dependencies": {
    "compression": "^1.8.2",
    "serverless-http": "^4.0.0"
  }
}
